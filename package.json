{
  "name": "deutsche-bahn-ausreden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare:model": "node tools/prepare-model.mjs",
    "prepare:pages": "pnpm verify:assets && pnpm build && node tools/prepare-pages.mjs",
    "verify:assets": "node tools/verify-assets.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@chenglou/pretext": "0.0.9",
    "@fontsource/roboto": "5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
